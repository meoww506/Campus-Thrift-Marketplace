<%- include('partials/header', {title:'Home'}) %>
<section class="hero-section">
  <div class="hero-copy">
    <span class="eyebrow">THE CAMPUS MARKETPLACE</span>
    <h1>Good finds.<br><em>Second lives.</em></h1>
    <p>Buy and sell pre-loved essentials with people in your campus community. Simple, local, and a little kinder to the planet.</p>
    <div class="d-flex gap-2 flex-wrap"><a class="btn btn-gold" href="/products">Explore marketplace <span>→</span></a><a class="btn btn-outline-light" href="/sell">List an item</a></div>
    <div class="hero-stats"><div><strong>Local</strong><small>Campus community</small></div><div><strong>Nu.</strong><small>Simple pricing</small></div><div><strong>Reuse</strong><small>Less waste</small></div></div>
  </div>
  <div class="hero-art">
    <div class="hero-card card-one"><span class="mini-label">GOOD AS NEW</span><div class="art-book">BOOK<br><small>EDITION</small></div><strong>Study essentials</strong><small>Find your next favourite</small></div>
    <div class="hero-card card-two"><div class="art-bag">✦</div><strong>Campus finds</strong><small>Passed on, not thrown away</small></div>
    <div class="hero-seal">BUY<br><b>LOCAL</b><br>REUSE</div>
  </div>
</section>
<section class="trust-row">
  <div><span>✧</span><strong>Campus community</strong><small>Students & staff</small></div>
  <div><span>♧</span><strong>Thoughtful reuse</strong><small>Give items another life</small></div>
  <div><span>⌂</span><strong>Campus handover</strong><small>Meet safely in person</small></div>
</section>
<section class="section-block">
  <div class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h2>Shop by category</h2></div><a href="/products">View all items →</a></div>
  <div class="category-grid">
    <% categories.forEach((c,i)=> { const icons=['▤','⌁','◇','⌂','⚽','✧','＋']; %>
      <a class="category-tile" href="/products?category=<%= c.id %>"><span><%= icons[i%icons.length] %></span><strong><%= c.name %></strong><small>Explore items →</small></a>
    <% }) %>
  </div>
</section>
<section class="section-block">
  <div class="section-heading"><div><span class="eyebrow">FRESH ON CAMPUS</span><h2>Recently listed</h2></div><a href="/products">See marketplace →</a></div>
  <%- include('partials/product-grid', {items}) %>
</section>
<section class="sell-banner"><div><span class="eyebrow">CLEAR SOME SPACE</span><h2>Someone else might need<br>what you no longer use.</h2><p>List your item in a few minutes and connect with buyers around campus.</p></div><a class="btn btn-gold" href="<%= currentUser ? '/sell' : '/register' %>">Start selling →</a></section>
<%- include('partials/footer') %>
