<%- include('../partials/header', {title:'Review reports'}) %>
<div class="page-title-row"><div><span class="eyebrow">ADMIN / REPORTS</span><h1>Community reports</h1><p>Review reported listings and record an outcome.</p></div><a href="/admin" class="btn btn-outline-dark">← Dashboard</a></div>
<div class="report-list"><% reports.forEach(r=> { %><article class="report-card"><div><span class="status-pill"><%= r.status %></span><h3><%= r.title %></h3><p><%= r.reason %></p><small>Reported by <%= r.reporter_name %> · <%= new Date(r.created_at).toLocaleDateString() %></small></div><div class="d-flex gap-2"><form method="POST" action="/admin/reports/<%= r.id %>/status"><input type="hidden" name="status" value="reviewed"><button class="btn btn-sm btn-success">Reviewed</button></form><form method="POST" action="/admin/reports/<%= r.id %>/status"><input type="hidden" name="status" value="dismissed"><button class="btn btn-sm btn-outline-dark">Dismiss</button></form></div></article><% }) %><% if (!reports.length) { %><div class="empty-state">No reports have been submitted.</div><% } %></div>
<%- include('../partials/footer') %>
