<%- include('../partials/header', {title:'Moderate listings'}) %>
<div class="page-title-row"><div><span class="eyebrow">ADMIN / LISTINGS</span><h1>Marketplace listings</h1><p>Review listing details and remove inappropriate content.</p></div><a href="/admin" class="btn btn-outline-dark">← Dashboard</a></div>
<div class="table-responsive"><table class="table align-middle marketplace-table"><thead><tr><th>Item</th><th>Seller</th><th>Price</th><th>Status</th><th>Action</th></tr></thead><tbody><% items.forEach(i=> { %><tr><td><a href="/products/<%= i.id %>"><strong><%= i.title %></strong></a><small class="d-block text-muted"><%= i.category_name || 'Other' %></small></td><td><%= i.seller_name %></td><td>Nu. <%= Number(i.price).toLocaleString('en-IN') %></td><td><span class="status-pill"><%= i.status %></span></td><td><% if (i.status!=='removed') { %><form method="POST" action="/admin/listings/<%= i.id %>/remove"><button class="btn btn-sm btn-outline-danger">Remove</button></form><% } else { %>—<% } %></td></tr><% }) %></tbody></table></div>
<%- include('../partials/footer') %>
