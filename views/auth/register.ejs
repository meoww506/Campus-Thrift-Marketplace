<%- include('../partials/header', {title:'Create account'}) %>
<div class="auth-wrap"><div class="auth-decoration"><span class="eyebrow">JOIN THE COMMUNITY</span><h1>Pass it on. Find something useful.</h1><p>One account lets you buy and sell. Your account type simply identifies you as a student or staff member.</p><div class="auth-pattern">✧ ◇ ✧ ◇ ✧</div></div><form class="auth-card" method="POST" action="/register"><span class="eyebrow">GET STARTED</span><h2>Create account</h2><label>Full name</label><input class="form-control" name="full_name" required minlength="2"><label>Email address</label><input class="form-control" type="email" name="email" required><label>Campus ID (optional)</label><input class="form-control" name="campus_id"><label>Phone (optional)</label><input class="form-control" name="phone"><label>Account type</label><select class="form-select" name="user_type" required><option value="student">Student</option><option value="staff">Staff</option></select><label>Password (minimum 8 characters)</label><input class="form-control" type="password" name="password" minlength="8" required><button class="btn btn-maroon w-100 mt-3">Create account</button><p class="auth-switch">Already registered? <a href="/login">Sign in</a></p></form></div>
<%- include('../partials/footer') %>
