<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Campus Thrift' %> | Campus Thrift</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<div class="pattern-strip"></div>
<nav class="navbar navbar-expand-lg navbar-dark main-nav">
  <div class="container">
    <a class="navbar-brand brand" href="/">Campus<span>Thrift</span><small>BHUTAN</small></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="mainNav">
      <form class="search-form mx-lg-auto my-3 my-lg-0" action="/products" method="GET">
        <input name="q" class="form-control" placeholder="Search books, electronics, essentials..." aria-label="Search products">
        <button aria-label="Search">⌕</button>
      </form>
      <div class="nav-actions">
        <a href="/products">Explore</a>
        <% if (currentUser) { %>
          <a href="/wishlist">Wishlist</a>
          <a href="/dashboard">My account</a>
          <form action="/logout" method="POST"><button class="nav-link-btn">Sign out</button></form>
        <% } else { %>
          <a href="/login">Sign in</a>
          <a class="nav-sell" href="/register">Join / Sell</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
<div class="sub-nav">
  <div class="container d-flex flex-wrap gap-3 align-items-center">
    <a href="/products">All items</a><a href="/products?category=1">Books & notes</a><a href="/products">Electronics</a><a href="/products">Hostel essentials</a><a href="/sell">Sell an item</a>
    <span class="ms-auto campus-note">A little more reuse, a little less waste.</span>
  </div>
</div>
<main class="container page-wrap">
<% if (notice) { %><div class="alert alert-<%= notice.type %> alert-dismissible fade show mt-3"><%= notice.message %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
