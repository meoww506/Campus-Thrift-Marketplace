
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= title || 'Campus Thrift' %> | Campus Thrift</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/public/css/style.css">
</head>

<body>

<div class="pattern-strip"></div>

<nav class="navbar navbar-expand-lg navbar-dark main-nav">
  <div class="container">

    <a class="navbar-brand brand" href="/">
      Campus<span>Thrift</span>
      <small>BHUTAN</small>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNav"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">

      <% if (!currentUser || currentUser.role !== 'admin') { %>

        <form
          class="search-form mx-lg-auto my-3 my-lg-0"
          action="/products"
          method="GET"
        >
          <input
            name="q"
            class="form-control"
            placeholder="Search books, electronics, essentials..."
            aria-label="Search products"
          >

          <button type="submit" aria-label="Search">⌕</button>
        </form>

      <% } %>

      <div class="nav-actions">

        <% if (currentUser && currentUser.role === 'admin') { %>

          <!-- ADMIN NAVIGATION -->

          <a href="/admin">Dashboard</a>
          <a href="/admin/users">Manage users</a>
          <a href="/admin/listings">Listings</a>
          <a href="/admin/reports">Reports</a>

          <form action="/admin/logout" method="POST">
            <button type="submit" class="nav-link-btn">
              Sign out
            </button>
          </form>

        <% } else if (currentUser) { %>

          <!-- STUDENT AND STAFF NAVIGATION -->

          <a href="/products">Explore</a>
          <a href="/wishlist">Wishlist</a>
          <a href="/dashboard">My account</a>

          <form action="/logout" method="POST">
            <button type="submit" class="nav-link-btn">
              Sign out
            </button>
          </form>

        <% } else { %>

          <!-- VISITOR NAVIGATION -->

          <a href="/products">Explore</a>
          <a href="/login">Sign in</a>
          <a class="nav-sell" href="/register">Join / Sell</a>

        <% } %>

      </div>
    </div>
  </div>
</nav>


<% if (!currentUser || currentUser.role !== 'admin') { %>

  <!-- MARKETPLACE CATEGORY NAVIGATION -->

  <div class="sub-nav">
    <div class="container d-flex flex-wrap gap-3 align-items-center">

      <a href="/products">All items</a>

      <a href="/products?category=1">Books &amp; notes</a>

      <a href="/products?category=2">Electronics</a>

      <a href="/products?category=3">Clothing</a>

      <a href="/products?category=4">Hostel essentials</a>

      <a href="/products?category=5">Sports</a>

      <a href="/products?category=6">Accessories</a>

      <a href="/products?category=7">Other</a>

      <% if (currentUser) { %>
        <a href="/sell">Sell an item</a>
      <% } %>

      <span class="ms-auto campus-note">
        A little more reuse, a little less waste.
      </span>

    </div>
  </div>

<% } else { %>

  <!-- ADMIN SECONDARY NAVIGATION -->

  <div class="sub-nav">
    <div class="container d-flex flex-wrap gap-3 align-items-center">

      <a href="/admin">Overview</a>
      <a href="/admin/users">User management</a>
      <a href="/admin/listings">Listing moderation</a>
      <a href="/admin/reports">Community reports</a>

      <span class="ms-auto campus-note">
        Campus Thrift Administration
      </span>

    </div>
  </div>

<% } %>


<main class="container page-wrap">

  <% if (notice) { %>

    <div class="alert alert-<%= notice.type %> alert-dismissible fade show mt-3">

      <%= notice.message %>

      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
      ></button>

    </div>

  <% } %>
